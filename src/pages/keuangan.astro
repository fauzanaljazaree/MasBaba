---
import * as XLSX from 'xlsx';
import '../styles/global.css';

const namaMasjid = 'Masjid Baitul Barokah';

const XLSX_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSYRGdIJonG8O6PwF1ceNNwUMypxK7wju05pdQ39trRcwhv_bKzoKUMUJrfwB_svg/pub?output=xlsx';
const SPREADSHEET_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSYRGdIJonG8O6PwF1ceNNwUMypxK7wju05pdQ39trRcwhv_bKzoKUMUJrfwB_svg/pubhtml';
const CHART_EMBED_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSYRGdIJonG8O6PwF1ceNNwUMypxK7wju05pdQ39trRcwhv_bKzoKUMUJrfwB_svg/pubhtml?gid=789856132&single=true&widget=true&headers=false';

const angkaSel = (v: unknown) => (typeof v === 'number' ? v : 0);

async function ambilDataKas() {
  const fallback = { pemasukan: 1749000, pengeluaran: 1407500, saldo: 24802500 };
  try {
    const response = await fetch(XLSX_URL);
    const buffer = await response.arrayBuffer();
    const workbook = XLSX.read(buffer, { type: 'array' });
    const sheet = workbook.Sheets['Dashboard & Ringkasan'];
    if (!sheet) return fallback;
    return {
      pemasukan: angkaSel(sheet['E6']?.v) || fallback.pemasukan,
      pengeluaran: angkaSel(sheet['H6']?.v) || fallback.pengeluaran,
      saldo: angkaSel(sheet['K6']?.v) || fallback.saldo,
    };
  } catch {
    return fallback;
  }
}

const { pemasukan, pengeluaran, saldo } = await ambilDataKas();

const formatRupiah = (angka: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);

const ringkasan = [
  { id: 'pemasukan', label: 'Total Pemasukan', nilai: formatRupiah(pemasukan), warna: 'text-emerald-600', bg: 'bg-emerald-50', border: 'border-emerald-200' },
  { id: 'pengeluaran', label: 'Total Pengeluaran', nilai: formatRupiah(pengeluaran), warna: 'text-rose-600', bg: 'bg-rose-50', border: 'border-rose-200' },
  { id: 'saldo', label: 'Saldo Kas Saat Ini', nilai: formatRupiah(saldo), warna: 'text-sky-600', bg: 'bg-sky-50', border: 'border-sky-200' },
];
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Keuangan - {namaMasjid}</title>
	</head>
	<body class="bg-gray-50 min-h-screen flex flex-col">
		<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-200">
			<nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
				<a href="/" class="flex items-center gap-2">
					<span class="text-3xl">🕌</span>
					<span class="font-bold text-xl text-emerald-800">{namaMasjid}</span>
				</a>
				<div class="hidden md:flex items-center gap-8 text-base font-medium text-gray-700">
					<a href="/" class="hover:text-emerald-700 transition-colors">Beranda</a>
					<a href="/profil" class="hover:text-emerald-700 transition-colors">Profil</a>
					<div class="relative group">
						<a href="#kegiatan" class="hover:text-emerald-700 transition-colors flex items-center gap-1">
							Kegiatan
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
							</svg>
						</a>
						<div class="absolute left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
							<a href="#kajian" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">Kajian Rutin</a>
							<a href="#tpq" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">TPQ Sore</a>
							<a href="#madrasah" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">Madrasah Diniyah</a>
							<a href="#phbi" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">PHBI</a>
						</div>
					</div>
					<a href="/keuangan" class="text-emerald-700 font-semibold">Keuangan</a>
					<a href="/kontak" class="hover:text-emerald-700 transition-colors">Kontak</a>
				</div>
				<div class="flex items-center gap-3">
					<button type="button" aria-label="Cari" class="text-gray-600 hover:text-emerald-700 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
						</svg>
					</button>
					<a
						href="#donasi"
						class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors"
					>
						Donasi
					</a>
				</div>
			</nav>
		</header>

		<main class="flex-1 w-full max-w-6xl mx-auto px-4 py-10">
			<section class="mb-10">
				<h1 class="text-3xl font-bold text-emerald-800 mb-2">Keuangan {namaMasjid}</h1>
				<p class="text-gray-500">Laporan kas dan realisasi anggaran tahun 2026.</p>
			</section>

			<section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
				{
					ringkasan.map((r) => (
						<div class={`rounded-xl border ${r.border} ${r.bg} p-5`}>
							<p class="text-sm font-medium text-gray-600">{r.label}</p>
							<p id={`kas-${r.id}`} class={`text-2xl font-bold mt-2 ${r.warna}`}>{r.nilai}</p>
						</div>
					))
				}
			</section>

			<section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
				<h2 class="text-2xl font-bold text-emerald-800 mb-2">📊 Grafik Keuangan</h2>
				<p class="text-gray-500 text-sm mb-6">Grafik batang dan pie dari spreadsheet resmi.</p>
				<iframe
					src={CHART_EMBED_URL}
					class="w-full h-[600px] border-0 rounded-lg"
					loading="lazy"
					title="Grafik Keuangan Masjid"
				></iframe>
			</section>

			<section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
				<h2 class="text-2xl font-bold text-emerald-800 mb-4">📄 Detail Laporan</h2>
				<p class="text-gray-700 mb-4">Lihat laporan lengkap dan rincian transaksi pada spreadsheet resmi.</p>
				<a
					href={SPREADSHEET_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors"
				>
					Lihat detail disini
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
					</svg>
				</a>
			</section>
		</main>

		<footer class="bg-emerald-900 text-emerald-50">
			<div class="max-w-6xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm">
				<p>© 2026 {namaMasjid}. Semua hak dilindungi.</p>
				<p>Berdakwah dengan Ilmu, Beramal dengan Ikhlas</p>
			</div>
		</footer>
	</body>
</html>