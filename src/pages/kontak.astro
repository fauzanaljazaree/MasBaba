---
import '../styles/global.css';

const namaMasjid = 'Masjid Baitul Barokah';
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Kontak - {namaMasjid}</title>
	</head>
	<body class="bg-gray-50 min-h-screen flex flex-col">
		<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-200">
			<nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
				<a href="/" class="flex items-center gap-2">
					<span class="text-3xl">🕌</span>
					<span class="font-bold text-xl text-emerald-800">{namaMasjid}</span>
				</a>
				<div class="hidden md:flex items-center gap-8 text-base font-medium text-gray-700">
					<a href="/" class="hover:text-emerald-700 transition-colors">Beranda</a>
					<a href="/profil" class="hover:text-emerald-700 transition-colors">Profil</a>
					<div class="relative group">
						<a href="#kegiatan" class="hover:text-emerald-700 transition-colors flex items-center gap-1">
							Kegiatan
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
							</svg>
						</a>
						<div class="absolute left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
							<a href="#kajian" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">Kajian Rutin</a>
							<a href="#tpq" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">TPQ Sore</a>
							<a href="#madrasah" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">Madrasah Diniyah</a>
							<a href="#phbi" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">PHBI</a>
						</div>
					</div>
					<a href="/keuangan" class="hover:text-emerald-700 transition-colors">Keuangan</a>
					<a href="/kontak" class="text-emerald-700 font-semibold">Kontak</a>
				</div>
				<div class="flex items-center gap-3">
					<button type="button" aria-label="Cari" class="text-gray-600 hover:text-emerald-700 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
						</svg>
					</button>
					<a
						href="#donasi"
						class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors"
					>
						Donasi
					</a>
				</div>
			</nav>
		</header>

		<main class="flex-1 w-full max-w-4xl mx-auto px-4 py-10">
			<section class="mb-10">
				<h1 class="text-3xl font-bold text-emerald-800 mb-2">Kontak {namaMasjid}</h1>
				<p class="text-gray-500">Hubungi kami untuk informasi, saran, dan layanan.</p>
			</section>

			<section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
				<h2 class="text-2xl font-bold text-emerald-800 mb-4">📌 Informasi Kontak</h2>
				<div class="space-y-4 text-gray-700">
					<div>
						<p class="font-semibold text-gray-900">Alamat Fisik</p>
						<p>TPQ dan Masjid Baitul Barokah, Kebumen, Jawa Tengah 54311</p>
					</div>
					<div>
						<p class="font-semibold text-gray-900">Nomor Telepon / WhatsApp</p>
						<p>+62 812-3456-7890</p>
					</div>
					<div>
						<p class="font-semibold text-gray-900">Email Resmi</p>
						<a href="mailto:dkmmasbaba@gmail.com" class="text-emerald-700 hover:underline">dkmmasbaba@gmail.com</a>
					</div>
					<div>
						<p class="font-semibold text-gray-900">Media Sosial</p>
						<div class="flex items-center gap-4 mt-2">
							<a href="#" aria-label="Facebook" class="text-gray-600 hover:text-emerald-700 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z" />
								</svg>
							</a>
							<a href="#" aria-label="Instagram" class="text-gray-600 hover:text-emerald-700 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 01-1.38-.9 3.72 3.72 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.88 5.88 0 00-2.13 1.38A5.88 5.88 0 00.63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.72 1.48 1.38 2.13a5.88 5.88 0 002.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.88 5.88 0 002.13-1.38 5.88 5.88 0 001.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 00-1.38-2.13A5.88 5.88 0 0019.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 105.84 12 6.16 6.16 0 0012 5.84zM12 16a4 4 0 114-4 4 4 0 01-4 4zm6.4-11.85a1.44 1.44 0 11-1.44 1.44 1.44 1.44 0 011.44-1.44z" />
								</svg>
							</a>
							<a href="#" aria-label="YouTube" class="text-gray-600 hover:text-emerald-700 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 00.5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 002.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 002.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z" />
								</svg>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
				<h2 class="text-2xl font-bold text-emerald-800 mb-4">🗺️ Peta Lokasi</h2>
				<p class="text-gray-700 mb-4">Klik tombol di bawah untuk membuka lokasi masjid di Google Maps.</p>
				<a
					href="https://maps.app.goo.gl/bQJnpRob66pSL7n88"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
					</svg>
					Buka di Google Maps
				</a>
			</section>

			<section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
				<h2 class="text-2xl font-bold text-emerald-800 mb-4">✉️ Formulir Pesan & Layanan</h2>
				<form class="space-y-4">
					<div>
						<label for="nama" class="block text-sm font-medium text-gray-700 mb-1">Nama</label>
						<input
							type="text"
							id="nama"
							name="nama"
							required
							class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
							placeholder="Nama lengkap Anda"
						/>
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
							placeholder="email@contoh.com"
						/>
					</div>
					<div>
						<label for="layanan" class="block text-sm font-medium text-gray-700 mb-1">Pilihan Layanan</label>
						<select
							id="layanan"
							name="layanan"
							class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
						>
							<option value="">Pilih layanan...</option>
							<option value="konsultasi">Layanan Konsultasi Agama</option>
							<option value="pernikahan">Pendaftaran Pernikahan</option>
							<option value="aula">Penyewaan Aula / Ambulans</option>
						</select>
					</div>
					<div>
						<label for="pesan" class="block text-sm font-medium text-gray-700 mb-1">Isi Pesan</label>
						<textarea
							id="pesan"
							name="pesan"
							rows="4"
							required
							class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
							placeholder="Tulis saran, kritik, atau pertanyaan Anda..."
						></textarea>
					</div>
					<button
						type="submit"
						class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-2 rounded-lg transition-colors"
					>
						Kirim Pesan
					</button>
				</form>
			</section>
		</main>

		<footer class="bg-emerald-900 text-emerald-50">
			<div class="max-w-6xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm">
				<p>© 2026 {namaMasjid}. Semua hak dilindungi.</p>
				<p>Berdakwah dengan Ilmu, Beramal dengan Ikhlas</p>
			</div>
		</footer>
	</body>
</html>