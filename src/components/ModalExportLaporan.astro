---
/**
 * Tombol "Export Laporan Bulanan" beserta pop-up pemilihan bulan + PIN 6 angka.
 *
 * Daftar bulan dibatasi hanya bulan yang sudah terlewati penuh. PIN diverifikasi
 * di server oleh endpoint /api/laporan.pdf, lalu berkas PDF dikirim sebagai unduhan.
 */
import { opsiBulanTersedia } from '../lib/laporan-keuangan';

const daftarBulan = opsiBulanTersedia();
---

<button
	id="export-toggle"
	type="button"
	class="inline-flex items-center gap-2 bg-white hover:bg-emerald-50 text-emerald-700 border border-emerald-600 font-semibold px-4 py-2 rounded-lg transition-colors"
>
	Export Laporan Bulanan
	<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"></path>
	</svg>
</button>

<dialog
	id="export-modal"
	class="m-auto w-full max-w-md rounded-xl border border-gray-200 p-0 shadow-xl backdrop:bg-gray-900/50"
	aria-labelledby="export-judul"
>
	<form id="export-form" class="p-6">
		<h3 id="export-judul" class="text-xl font-bold text-emerald-800 mb-1">Export Laporan Bulanan</h3>
		<p class="text-sm text-gray-500 mb-5">
			Pilih bulan laporan keuangan, lalu masukkan PIN 6 angka untuk mengunduh berkas PDF.
		</p>

		<label for="export-bulan" class="block text-sm font-medium text-gray-700 mb-1">Bulan laporan</label>
		<select
			id="export-bulan"
			name="bulan"
			class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-gray-800 mb-4 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-100"
			required
		>
			{daftarBulan.map((opsi) => <option value={`${opsi.bulan}-${opsi.tahun}`}>{opsi.label}</option>)}
		</select>

		<label for="export-pin" class="block text-sm font-medium text-gray-700 mb-1">PIN (6 angka)</label>
		<input
			id="export-pin"
			name="pin"
			type="password"
			inputmode="numeric"
			autocomplete="off"
			maxlength="6"
			placeholder="••••••"
			class="w-full rounded-lg border border-gray-300 px-3 py-2 tracking-[0.5em] text-gray-800 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-100"
			required
		/>
		<p id="export-pesan" class="hidden text-sm text-rose-600 mt-2" role="alert"></p>

		<div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-6">
			<button
				id="export-batal"
				type="button"
				class="inline-flex justify-center px-4 py-2 rounded-lg border border-gray-300 text-gray-700 font-medium hover:bg-gray-50 active:bg-gray-100 transition-colors"
			>
				Batal
			</button>
			<button
				id="export-kirim"
				type="submit"
				class="inline-flex justify-center px-4 py-2 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 active:bg-emerald-800 disabled:opacity-60 disabled:cursor-not-allowed transition-colors"
			>
				Unduh PDF
			</button>
		</div>
	</form>
</dialog>

<script>
	const toggle = document.getElementById('export-toggle');
	const modal = document.getElementById('export-modal') as HTMLDialogElement | null;
	const form = document.getElementById('export-form') as HTMLFormElement | null;
	const pilihBulan = document.getElementById('export-bulan') as HTMLSelectElement | null;
	const inputPin = document.getElementById('export-pin') as HTMLInputElement | null;
	const pesan = document.getElementById('export-pesan');
	const tombolBatal = document.getElementById('export-batal');
	const tombolKirim = document.getElementById('export-kirim') as HTMLButtonElement | null;

	if (toggle && modal && form && pilihBulan && inputPin && pesan && tombolBatal && tombolKirim) {
		const tampilkanPesan = (teks: string) => {
			pesan.textContent = teks;
			pesan.classList.remove('hidden');
		};
		const sembunyikanPesan = () => {
			pesan.textContent = '';
			pesan.classList.add('hidden');
		};

		toggle.addEventListener('click', () => {
			sembunyikanPesan();
			modal.showModal();
			pilihBulan.focus();
		});

		tombolBatal.addEventListener('click', () => modal.close());

		// PIN hanya boleh angka, maksimal 6 digit.
		inputPin.addEventListener('input', () => {
			inputPin.value = inputPin.value.replace(/\D/g, '').slice(0, 6);
		});

		// Klik di luar area formulir menutup pop-up.
		modal.addEventListener('click', (event) => {
			if (event.target === modal) modal.close();
		});

		modal.addEventListener('close', () => {
			inputPin.value = '';
			sembunyikanPesan();
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			const [teksBulan, teksTahun] = pilihBulan.value.split('-');
			const bulan = Number(teksBulan);
			const tahun = Number(teksTahun);
			const label = pilihBulan.options[pilihBulan.selectedIndex]?.text ?? 'Laporan';

			if (!/^\d{6}$/.test(inputPin.value)) {
				tampilkanPesan('PIN harus terdiri dari 6 angka.');
				inputPin.focus();
				return;
			}

			tombolKirim.disabled = true;
			tombolKirim.textContent = 'Menyiapkan PDF...';

			try {
				const response = await fetch('/api/laporan.pdf', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ bulan, tahun, pin: inputPin.value }),
				});

				if (!response.ok) {
					const data = (await response.json().catch(() => null)) as { pesan?: string } | null;
					tampilkanPesan(data?.pesan ?? 'Laporan gagal diunduh. Coba lagi.');
					return;
				}

				const blob = await response.blob();
				const url = URL.createObjectURL(blob);
				const tautan = document.createElement('a');
				tautan.href = url;
				tautan.download = `Laporan-Keuangan-Masjid-${label.replace(/\s+/g, '-')}.pdf`;
				document.body.appendChild(tautan);
				tautan.click();
				tautan.remove();
				URL.revokeObjectURL(url);
				modal.close();
			} catch {
				tampilkanPesan('Tidak dapat menghubungi server. Periksa koneksi lalu coba lagi.');
			} finally {
				tombolKirim.disabled = false;
				tombolKirim.textContent = 'Unduh PDF';
			}
		});
	}
</script>
