---
const namaMasjid = 'Masjid Baitul Barokah';
const { aktif } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-200">
	<nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
		<a href="/" class="flex items-center gap-2">
			<span class="text-3xl">🕌</span>
			<span class="font-bold text-xl text-emerald-800">{namaMasjid}</span>
		</a>

		<!-- Menu Desktop -->
		<div class="hidden md:flex items-center gap-8 text-base font-medium text-gray-700">
			<a href="/" class={aktif === 'beranda' ? 'text-emerald-700 font-semibold' : 'hover:text-emerald-700 transition-colors'}>Beranda</a>
			<a href="/profil" class={aktif === 'profil' ? 'text-emerald-700 font-semibold' : 'hover:text-emerald-700 transition-colors'}>Profil</a>
			<div class="relative group">
				<a href="#kegiatan" class="hover:text-emerald-700 transition-colors flex items-center gap-1">
					Kegiatan
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
					</svg>
				</a>
				<div class="absolute left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
					<a href="#kajian" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">Kajian Rutin</a>
					<a href="#tpq" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">TPQ Sore</a>
					<a href="#madrasah" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">Madrasah Diniyah</a>
					<a href="#phbi" class="block px-4 py-2 text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">PHBI</a>
				</div>
			</div>
			<a href="/keuangan" class={aktif === 'keuangan' ? 'text-emerald-700 font-semibold' : 'hover:text-emerald-700 transition-colors'}>Keuangan</a>
			<a href="/kontak" class={aktif === 'kontak' ? 'text-emerald-700 font-semibold' : 'hover:text-emerald-700 transition-colors'}>Kontak</a>
		</div>

		<div class="flex items-center gap-3">
			<button type="button" aria-label="Cari" class="text-gray-600 hover:text-emerald-700 transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
				</svg>
			</button>
			<a
				href="#donasi"
				class="hidden sm:inline-block bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors"
			>
				Donasi
			</a>
			<!-- Tombol Hamburger -->
			<button id="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" class="md:hidden text-gray-700 hover:text-emerald-700 transition-colors">
				<svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
				<svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
	</nav>

	<!-- Menu Mobile -->
	<div id="nav-mobile" class="hidden md:hidden border-t border-gray-200 bg-white">
		<div class="px-4 py-3 space-y-1 text-base font-medium text-gray-700">
			<a href="/" class="block py-2 hover:text-emerald-700 transition-colors">Beranda</a>
			<a href="/profil" class="block py-2 hover:text-emerald-700 transition-colors">Profil</a>
			<button id="nav-kegiatan-toggle" type="button" class="w-full flex items-center justify-between py-2 hover:text-emerald-700 transition-colors">
				Kegiatan
				<svg id="nav-kegiatan-chevron" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
				</svg>
			</button>
			<div id="nav-kegiatan-sub" class="hidden pl-4 space-y-1">
				<a href="#kajian" class="block py-2 text-sm text-gray-600 hover:text-emerald-700 transition-colors">Kajian Rutin</a>
				<a href="#tpq" class="block py-2 text-sm text-gray-600 hover:text-emerald-700 transition-colors">TPQ Sore</a>
				<a href="#madrasah" class="block py-2 text-sm text-gray-600 hover:text-emerald-700 transition-colors">Madrasah Diniyah</a>
				<a href="#phbi" class="block py-2 text-sm text-gray-600 hover:text-emerald-700 transition-colors">PHBI</a>
			</div>
			<a href="/keuangan" class="block py-2 hover:text-emerald-700 transition-colors">Keuangan</a>
			<a href="/kontak" class="block py-2 hover:text-emerald-700 transition-colors">Kontak</a>
			<a href="#donasi" class="block py-2 text-center bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg transition-colors mt-2">
				Donasi
			</a>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const mobile = document.getElementById('nav-mobile');
	const iconOpen = document.getElementById('nav-icon-open');
	const iconClose = document.getElementById('nav-icon-close');
	const kegiatanToggle = document.getElementById('nav-kegiatan-toggle');
	const kegiatanSub = document.getElementById('nav-kegiatan-sub');
	const kegiatanChevron = document.getElementById('nav-kegiatan-chevron');

	toggle.addEventListener('click', () => {
		const isOpen = !mobile.classList.contains('hidden');
		if (isOpen) {
			// tutup
			mobile.classList.add('hidden');
			iconOpen.classList.remove('hidden');
			iconClose.classList.add('hidden');
		} else {
			// buka
			mobile.classList.remove('hidden');
			iconOpen.classList.add('hidden');
			iconClose.classList.remove('hidden');
		}
		toggle.setAttribute('aria-expanded', String(!isOpen));
	});

	kegiatanToggle.addEventListener('click', () => {
		const isHidden = kegiatanSub.classList.contains('hidden');
		kegiatanSub.classList.toggle('hidden');
		kegiatanChevron.classList.toggle('rotate-180', isHidden);
	});
</script>